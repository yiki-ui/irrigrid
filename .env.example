# ==============================================================================
# IrriGrid Environment Variables Template (.env.example)
# Copy this file to .env and adjust values as needed.
# All variables are optional for local evaluation; offline fallbacks are active.
# ==============================================================================

# ── 1. AI Providers ──────────────────────────────────────────────────────────
# Optional: Groq LLM API key for live agronomic AI assistant; free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: OpenRouter API key as secondary LLM fallback; get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── 2. Satellite & NDVI Providers ───────────────────────────────────────────
# Optional: Custom NDVI / satellite imagery provider API key; leave empty to use Rwanda regional baseline
NDVI_API_KEY=
# Optional: Sentinel Hub API key for satellite vegetation health monitoring; get at https://www.sentinel-hub.com
SENTINEL_HUB_API_KEY=
# Optional: Copernicus Data Space Ecosystem API key; get at https://dataspace.copernicus.eu
COPERNICUS_API_KEY=

# ── 3. Contact Email (Third-Party API Compliance) ───────────────────────────
# Optional: Contact email for User-Agent headers in external requests (NASA POWER, SoilGrids, Nominatim)
CONTACT_EMAIL=

# ── 4. CORS Settings ────────────────────────────────────────────────────────
# Optional: Comma-separated allowed origins for FastAPI backend; defaults to https://irrigrid.pages.dev,http://localhost:3000
CORS_ORIGINS=https://irrigrid.pages.dev,http://localhost:3000

# ── 5. Deployment & Runtime ──────────────────────────────────────────────────
# Optional: Port for local backend server (Render sets PORT dynamically in production)
PORT=8000
# Optional: Python module resolution path
PYTHONPATH=.
# Optional: Target Python runtime version for cloud deployment
PYTHON_VERSION=3.11.0
# Optional: Cryptographic secret key for session signing; generate via secrets.token_urlsafe(32)
SECRET_KEY=
# Optional: SQLite or PostgreSQL connection string; defaults to sqlite:///./data/irrigation.db
DATABASE_URL=sqlite:///./data/irrigation.db
# Optional: Application debug flag (True/False); default is False
DEBUG=False
# Optional: OpenWeatherMap API key for legacy weather client; get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
# Optional: NASA POWER API endpoint URL; default public endpoint needs no key
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point
